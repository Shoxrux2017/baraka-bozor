# The production env file, read twice: by `docker compose --env-file` for the
# ${...} in docker/compose.prod.yaml, and, through BB_ENV_FILE, by the PHP
# services as their environment. Copy it outside the repository (docker/*.env is
# ignored), fill the empty values, never commit the result.
#
# Compared with backend/.env.example: every variable there is listed here or is
# development-only (the walkthrough password, faker, Redis, Memcached,
# mail, AWS, broadcast, the session cookie settings, the maintenance store, the
# test login code). The framework's other config-only variables keep their
# defaults.

# --- Compose -----------------------------------------------------------------
COMPOSE_PROJECT_NAME=
# Absolute path of this very file, so the PHP services read it as env_file.
BB_ENV_FILE=
# The image tag, e.g. a git short hash.
BB_RELEASE=
# Where Caddy listens; leave the three below unset for 0.0.0.0:80 and :443.
# BB_PUBLISH_ADDRESS=
# BB_HTTP_PORT=
# BB_HTTPS_PORT=
# Host names, without scheme. Caddy gets a certificate for each.
API_HOST=
PANEL_HOST=
# Directory on the server holding the panel releases; Caddy serves its `current`.
PANEL_ROOT=
# A private /28 no other network on the server uses. It becomes TRUSTED_PROXIES.
EDGE_SUBNET=

# --- Application -------------------------------------------------------------
APP_NAME=
APP_ENV=production
APP_DEBUG=false
# php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# (`artisan key:generate --show` cannot run here: the boot check refuses first.)
APP_KEY=
# https:// plus API_HOST; the boot check refuses an empty or http:// value.
APP_URL=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Exactly one origin: https:// plus PANEL_HOST. `*` refuses to boot.
CORS_ALLOWED_ORIGINS=

# --- Logging -----------------------------------------------------------------
# To stderr, so `docker compose logs` has it.
LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Accounts and login ------------------------------------------------------
LOGIN_CODE_DRIVER=
# Stays empty in production (BR-ROLE-011): a test phone verifies with a fixed code.
LOGIN_CODE_TEST_PHONES=
# php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
PHONE_FINGERPRINT_KEY=
# Comma-separated; never remove a key that was once current.
PHONE_FINGERPRINT_PREVIOUS_KEYS=

# --- Delivery and maps -------------------------------------------------------
# Owner question 2 (W4-5); decide before the first release.
DELIVERY_HANDOFF_POINT=
GOOGLE_MAPS_GEOCODING_KEY=

# --- Database (also the db service's own credentials) ------------------------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Drivers -----------------------------------------------------------------
QUEUE_CONNECTION=database
CACHE_STORE=database
# No route uses a session: the web routes drop the web group (routes/web.php).
SESSION_DRIVER=array
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12
