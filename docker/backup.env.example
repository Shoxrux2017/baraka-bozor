# The backup service's own env file (DL-104 (6)): never the app's credentials.
# Copy it outside the repository (docker/*.env is ignored), fill the values,
# never commit the result. Name it in BACKUP_ENV_FILE of the production env
# file. Generated values: `openssl rand -hex 32`, written unquoted.

# Where restic keeps the copies, one of:
#   s3:https://<endpoint>/<bucket>/barakabozor
#   sftp:<user>@<host>:/barakabozor
# A mistyped address makes a backup fail; it never creates a new repository.
RESTIC_REPOSITORY=

# Encrypts every copy. It lives in this file on the server and with the Owner:
# a lost password means copies nobody can read.
RESTIC_PASSWORD=

# Only for an s3: repository.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# The password of the read-only database role barakabozor_backup (the name is
# fixed in compose.prod.yaml). create-role.sh creates the role with this
# password; the role reads every table and writes nothing.
PGPASSWORD=

# Optional: a dead man's switch URL pinged after each successful night. A failed
# ping is logged and never fails the backup.
BACKUP_PING_URL=
