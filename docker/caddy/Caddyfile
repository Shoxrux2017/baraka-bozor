{
	# No access log: a query string such as a board search can carry phone
	# digits (docs/07 section 31). The error log still names the request, so
	# every logged URI loses its query string.
	log {
		output stderr
		format filter {
			wrap json
			fields {
				request>uri regexp \?.*$ ?redacted
			}
		}
	}
	# UDP 443 is not opened, so HTTP/3 is not offered.
	servers {
		protocols h1 h2
	}
	skip_install_trust
}

{$API_HOST} {
	encode zstd gzip
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
	}
	# Above PHP's post_max_size (8M), so an oversized upload still meets
	# Laravel's 413 envelope up to this bound.
	request_body {
		max_size 10MB
	}

	# Product images, straight from the volume. A new image gets a new URL
	# (docs/07 section 10), so a year's cache is safe; the panel draws them
	# from another origin (DL-34).
	handle_path /storage/* {
		root * /srv/storage
		header Cache-Control "public, max-age=31536000, immutable"
		header Access-Control-Allow-Origin {$CORS_ALLOWED_ORIGINS}
		file_server
	}

	# A deploy replaces the app container (DL-141 (6)): while docker/deploy.sh
	# holds maintenance/on, the API answers the contract's planned-maintenance
	# envelope (docs/09 section 3). Images above are still served.
	# The root is named: a bare absolute path is joined to the site root.
	@maintenance file {
		root /srv/maintenance
		try_files /on
	}
	handle @maintenance {
		# A CORS preflight is not the request itself: answer it, so the panel
		# can read the 503 below.
		@preflight method OPTIONS
		handle @preflight {
			header {
				Access-Control-Allow-Origin {$CORS_ALLOWED_ORIGINS}
				Access-Control-Allow-Methods {http.request.header.Access-Control-Request-Method}
				Access-Control-Allow-Headers {http.request.header.Access-Control-Request-Headers}
				Access-Control-Max-Age 60
			}
			respond 204
		}
		handle {
			header {
				Retry-After 30
				Cache-Control no-store
				Content-Type application/json
				Access-Control-Allow-Origin {$CORS_ALLOWED_ORIGINS}
				Access-Control-Expose-Headers Retry-After
			}
			respond `{"message":"The service is being updated.","code":"service_unavailable","errors":{},"request_id":"req_{http.request.uuid}"}` 503
		}
	}

	handle {
		rewrite * /index.php
		reverse_proxy app:9000 {
			transport fastcgi {
				root /app/public
				split .php
			}
		}
	}
}

{$PANEL_HOST} {
	root * /srv/panel/current
	encode zstd gzip
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# Flutter's file names are not content-hashed: index.html,
		# flutter_bootstrap.js and main.dart.js keep their names across
		# releases, so every file revalidates (ETag) instead of being cached.
		Cache-Control no-cache
	}
	try_files {path} /index.html
	file_server
}
