<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnEmptyTestSuite="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- The suite runs against the PostgreSQL test database created by
             docker/initdb/01-create-test-database.sql. Never SQLite: it diverges
             on column types, partial unique indexes and transaction behavior.
             See docs/07-architecture.md Section 33. -->
        <!-- Each connection value is set twice, on purpose. <env force="true">
             writes putenv() and $_ENV, which is what neutralises a .env file.
             But Laravel reads $_SERVER before $_ENV, and the PHP CLI copies the
             process environment into $_SERVER, so a DB_* exported by Compose,
             a shell or a CI runner would still win. <server> writes $_SERVER
             unconditionally and closes that path. DB_URL is included because
             Laravel prefers it over the discrete values. tests/TestCase.php
             additionally refuses to migrate any database not named *_test. -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_HOST" value="db" force="true"/>
        <env name="DB_PORT" value="5432" force="true"/>
        <env name="DB_DATABASE" value="baraka_bozor_test" force="true"/>
        <env name="DB_USERNAME" value="baraka" force="true"/>
        <env name="DB_PASSWORD" value="baraka_local_dev" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <server name="DB_CONNECTION" value="pgsql"/>
        <server name="DB_HOST" value="db"/>
        <server name="DB_PORT" value="5432"/>
        <server name="DB_DATABASE" value="baraka_bozor_test"/>
        <server name="DB_USERNAME" value="baraka"/>
        <server name="DB_PASSWORD" value="baraka_local_dev"/>
        <server name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
