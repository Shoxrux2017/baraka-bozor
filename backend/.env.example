APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Behind the production reverse proxy set this to the proxy's address or CIDR,
# otherwise the per-IP login limit counts every client as the proxy. See
# config/trustedproxy.php. Empty in development.
TRUSTED_PROXIES=

# Origins allowed to call the API from a browser, see config/cors.php.
# `*` is for development only; production names the panel's origin.
CORS_ALLOWED_ORIGINS=*

# Customer login codes, see config/login_codes.php. `fake` delivers nothing and
# is for development and tests only. Test phones verify with the fixed code and
# never receive one; both stay empty in production. Shoppers and Couriers sign
# in with the code too, so the local walkthroughs (tasks/scripts) also need
# their phones listed here: +998900000002 (Shopper), +998900000021 (wave 1
# Shopper), +998900000022 and +998900000023 (wave 3 Couriers).
LOGIN_CODE_DRIVER=fake
PUSH_DRIVER=fake
LOGIN_CODE_TEST_PHONES=
LOGIN_CODE_TEST_CODE=
# The store reviewer's phone and its own fixed code (DL-105): both or neither,
# six digits, not guessable, different from the test code. Allowed in production.
LOGIN_CODE_REVIEWER_PHONE=
LOGIN_CODE_REVIEWER_CODE=
# Most paid code checks per Tashkent day for phones without an account.
LOGIN_CODE_DAILY_LIMIT=500
# The Telegram Gateway API token, used by LOGIN_CODE_DRIVER=telegram.
TELEGRAM_GATEWAY_TOKEN=

# The secret the block list's phone fingerprints are made with, see
# config/accounts.php. Required. Generate one with
# php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# Never remove a key from the previous list (comma-separated): a fingerprint
# cannot be re-made without its phone.
PHONE_FINGERPRINT_KEY=
PHONE_FINGERPRINT_PREVIOUS_KEYS=

# The staff accounts of the local walkthrough, see config/walkthrough.php;
# the seeder refuses to run outside the local environment.
WALKTHROUGH_STAFF_PASSWORD=

# Whether Couriers collect orders at the handoff point, see config/delivery.php.
# While false, a Courier's order carries the phone of the Shopper who bought it.
DELIVERY_HANDOFF_POINT=true

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL is the only supported engine; see docs/07-architecture.md Section 2.
# These values match the Compose stack in docker/compose.yaml, where the
# database is reachable as host "db". Use 127.0.0.1 instead when connecting from
# the host with a database client. Real credentials never live in this file.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=baraka_bozor
DB_USERNAME=baraka
DB_PASSWORD=baraka_local_dev

# 'database' is unavailable: there is no sessions table. See config/session.php.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GOOGLE_MAPS_GEOCODING_KEY=
