APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Behind the production reverse proxy set this to the proxy's address or CIDR,
# otherwise the per-IP login limit counts every client as the proxy. See
# config/trustedproxy.php. Empty in development.
TRUSTED_PROXIES=

# Customer login codes, see config/login_codes.php. `fake` delivers nothing and
# is for development and tests only. Test phones verify with the fixed code and
# never receive one; both stay empty in production.
LOGIN_CODE_DRIVER=fake
LOGIN_CODE_TEST_PHONES=
LOGIN_CODE_TEST_CODE=

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL is the only supported engine; see docs/07-architecture.md Section 2.
# These values match the Compose stack in docker/compose.yaml, where the
# database is reachable as host "db". Use 127.0.0.1 instead when connecting from
# the host with a database client. Real credentials never live in this file.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=baraka_bozor
DB_USERNAME=baraka
DB_PASSWORD=baraka_local_dev

# 'database' is unavailable: there is no sessions table. See config/session.php.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
